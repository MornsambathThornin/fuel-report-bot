# Required
TELEGRAM_BOT_TOKEN=paste-token-from-BotFather-here
GOOGLE_SHEET_ID=paste-google-sheet-id-here

# Service account: provide ONE of these:
#   (a) Path to JSON file (local dev — default)
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
#   (b) Full JSON content as a single line (cloud hosts — Railway, Render, etc.)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional one-shot bootstrap (for cloud deploy with empty whitelist).
# If whitelist has zero admins and these are set, the bot will auto-add this admin on startup.
# INITIAL_ADMIN_ID=123456789
# INITIAL_ADMIN_NAME=Your Name

# Optional cosmetic
COMPANY_NAME_KH=ក្រុមហ៊ុន អេកូ អ៊ែតស៍ & ហ្រ្គីន (អ៊ី អេ ជី)
TIMEZONE=Asia/Phnom_Penh
